---
// The maker, and under it what search engines and newcomers both want: what it is, how to use
// it, and answers to the usual questions (also given to search engines as structured data).
import { faqPage, webApplication } from '@eurth/style/build';
import Page from '@eurth/style/components/Page.astro';
import { site } from '../../eurth.config.mjs';
import Maker from '../tool/Maker.svelte';

const faq = [
  { q: 'Is Starter free?', a: 'Yes. There is no account, no watermark and no paid tier. It is made by the Eurth worldbuilding community for anyone who needs it.' },
  { q: 'Where is my plate saved?', a: 'In its link. The link holds the whole design, so copying the link is saving it. You can also download the picture, or save your nation as a profile file that the other Eurth tools can read. Nothing is kept in your browser or on a server.' },
  { q: 'Does it work offline, and on a phone?', a: 'Yes to both. After the first visit the site keeps a copy of itself on your device and opens without a connection.' },
];
---

<Page site={site} jsonld={[webApplication(site, { featureList: ['Motto plates', 'Link that holds the design', 'SVG and PNG downloads', 'Nation profile file'] }), faqPage(faq)]}>
  <div class="eu-stack">
    <header class="eu-stack intro">
      <p class="eu-kicker">Starter, by Eurth</p>
      <h1>A motto plate for your nation</h1>
      <p class="eu-lead">Name your nation, give it a motto, decide how seriously it means it. Free, in your browser, no account needed.</p>
    </header>

    <!-- client:load draws the maker as real HTML first, then wakes it up. -->
    <Maker client:load siteName={site.name} siteUrl={site.url} />

    <section class="eu-prose">
      <h2>How it works</h2>
      <ol>
        <li>Type your nation's name and its motto, or press Random and edit what comes out.</li>
        <li>Set the gravitas: how solemnly the motto is meant. The frame thickens with it.</li>
        <li>Copy the link, the picture or the description, or share it with the Eurth forum.</li>
      </ol>
      <p>New to mottos? The <a href="/guide/">guide</a> explains what makes one last, the <a href="/glossary/">glossary</a> has the words, and the <a href="/templates/">templates</a> give you somewhere to start.</p>

      <h2>Questions</h2>
      <dl>
        {
          faq.map((item) => (
            <>
              <dt>{item.q}</dt>
              <dd>{item.a}</dd>
            </>
          ))
        }
      </dl>
    </section>
  </div>

  <Fragment slot="inspirations">Starter is the template every Eurth tool begins from; it takes after Flagwright and Governmint.</Fragment>
</Page>

<style>
  .intro {
    gap: var(--space-2);
  }
</style>
