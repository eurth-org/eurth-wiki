---
// Templates: ready-made results, each a link into the maker. The links are made at build time
// with the same code the maker uses, so they can never drift apart.
import { encodeState } from '@eurth/style';
import Page from '@eurth/style/components/Page.astro';
import { site } from '../../eurth.config.mjs';
import { compact, describe, plateSvg, templates } from '../tool/model';
---

<Page
  site={site}
  title="Motto plate templates"
  description="Three ready-made motto plates to start from: a calm republic, an old mountain kingdom and a federation that hasn't decided. Open one and make it yours."
  crumbs={[{ name: 'Templates', path: '/templates/' }]}
>
  <div class="eu-stack">
    <header class="eu-prose">
      <p class="eu-kicker">Templates</p>
      <h1>Motto plate templates</h1>
      <p class="eu-lead">Somewhere to start. Open one in the <a href="/">maker</a> and change what you like; the <a href="/guide/">guide</a> says what makes a motto last.</p>
    </header>
    <ul class="gallery">
      {
        templates.map((t) => (
          <li>
            <a class="eu-card" href={`/?d=${encodeState(compact(t.plate))}`}>
              <img src={`data:image/svg+xml;charset=utf-8,${encodeURIComponent(plateSvg(t.plate))}`} alt={describe(t.plate)} width="1200" height="630" loading="lazy" />
              <h2>{t.name}</h2>
              <p>{t.note}</p>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</Page>

<style>
  .gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .gallery img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius-md);
  }

  .gallery h2 {
    font: var(--type-heading);
  }
</style>
